{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mdxx",
  "version": "0.1.0",
  "identifier": "com.mdxx.editor",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "mdxx",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mdxx"],
        "name": "MDXX Document",
        "description": "MDXX rich text document",
        "mimeType": "application/x-mdxx",
        "role": "Editor"
      }
    ]
  }
}
