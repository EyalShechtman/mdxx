{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mdxx",
  "version": "0.3.0",
  "identifier": "com.mdxx.editor",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "mdxx",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mdxx"],
        "name": "MDXX Document",
        "description": "MDXX rich text document",
        "mimeType": "application/x-mdxx",
        "role": "Editor"
      },
      {
        "ext": ["md"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMDEwRDIwRTZGREJGNTAKUldSUXYvM21JQTBCcnZrNkNqZnJwaHpXaCtFQzhwcm5mT3BEdC96YmpmQU05Ry8yOE15cllrZlYK",
      "endpoints": [
        "https://github.com/EyalShechtman/mdxx/releases/latest/download/latest.json"
      ]
    }
  }
}
